<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.webport.traefik</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/webport/run-traefik</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>WorkingDirectory</key>
	<string>/usr/local/var/lib/traefik</string>
	<key>StandardOutPath</key>
	<string>/usr/local/var/log/traefik/traefik.log</string>
	<key>StandardErrorPath</key>
	<string>/usr/local/var/log/traefik/traefik.log</string>
</dict>
</plist>
