[Unit]
Description=Webport Traefik Config Manager
After=network-online.target traefik.service
Wants=network-online.target
Requires=traefik.service
PartOf=webport-stack.target

[Service]
Type=notify
NotifyAccess=all
User=webport
Group=webport
EnvironmentFile=/etc/webport/webport.env
WatchdogSec=30
ExecStart=/usr/local/bin/webport daemon
TimeoutStopSec=10
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/traefik/dynamic
# /run/webport holds the session socket; /var/lib/webport holds web UI settings.
RuntimeDirectory=webport
RuntimeDirectoryMode=0755
StateDirectory=webport
StateDirectoryMode=0700
StandardOutput=journal
StandardError=journal
SyslogIdentifier=webport

[Install]
WantedBy=multi-user.target
