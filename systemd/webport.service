[Unit]
Description=Webport Traefik Config Manager
After=network-online.target traefik.service
Wants=network-online.target traefik.service

[Service]
Type=notify
NotifyAccess=all
User=root
Group=root
EnvironmentFile=/etc/webport/webport.env
WatchdogSec=30
ExecStart=/usr/local/bin/webport
TimeoutStopSec=10
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/traefik/dynamic
StandardOutput=journal
StandardError=journal
SyslogIdentifier=webport

[Install]
WantedBy=multi-user.target
