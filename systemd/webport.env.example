# Required
WEBPORT_BASE_DOMAIN=webport.localhost

# Core service configuration
WEBPORT_TRAEFIK_DYNAMIC_CONFIG_PATH=/etc/traefik/dynamic/webport.yml
WEBPORT_TRAEFIK_ENTRYPOINT=websecure
WEBPORT_TRAEFIK_CERT_RESOLVER=webport
WEBPORT_TLS_MODE=local-ca
# WEBPORT_LOCAL_CA_DIR=/etc/traefik/dynamic/webport-pki
# Local-only alternative:
# WEBPORT_BASE_DOMAIN=webport.localhost
# WEBPORT_TLS_MODE=local-ca
WEBPORT_LISTEN_HOST=127.0.0.1
WEBPORT_PORT=8080
WEBPORT_DEFAULT_TTL=30s
WEBPORT_TTL_CHECK_INTERVAL=10s
WEBPORT_SHUTDOWN_TIMEOUT=5s
WEBPORT_DISCOVERY_ENABLED=false
WEBPORT_DISCOVERY_INTERVAL=2s

# Optional persistent wildcard DNS management for webport-dns
# WEBPORT_DNS_PROVIDER=cloudflare
# WEBPORT_DNS_CREDENTIALS_FILE=/etc/traefik/traefik.env
# WEBPORT_DNS_ZONE=example.com
