# Required
WEBPORT_BASE_DOMAIN=dev.example.com

# Core service configuration
WEBPORT_CADDYFILE_PATH=/etc/caddy/webport.d/Caddyfile
WEBPORT_LISTEN_HOST=127.0.0.1
WEBPORT_PORT=8080
WEBPORT_DEFAULT_TTL=300s
WEBPORT_CADDY_RELOAD_CMD=caddy reload --config /etc/caddy/Caddyfile
WEBPORT_TTL_CHECK_INTERVAL=30s
WEBPORT_SHUTDOWN_TIMEOUT=5s

# Optional DNS-01 configuration
# WEBPORT_TLS_DNS_PROVIDER=cloudflare
# WEBPORT_TLS_DNS_PROVIDER_MODULE=cloudflare
# WEBPORT_TLS_DNS_TOKEN_ENV_VAR=CLOUDFLARE_API_TOKEN

# Optional persistent wildcard DNS management for webport-dns
# WEBPORT_DNS_CREDENTIALS_FILE=/etc/caddy/caddy.env
# WEBPORT_DNS_ZONE=example.com
